{
    "expo": {
        "name": "testing-app",
        "slug": "testing-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icons/android.png",
        "scheme": "testingapp",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "notification": {
            "icon": "./assets/icons/notification.png",
            "color": "#ffffff",
            "iosDisplayInForeground": true
        },
        "splash": {
            "image": "./assets/icons/splash-screen.png",
            "resizeMode": "contain",
            "backgroundColor": "#000000"
        },
        "ios": {
            "icon": "./assets/icons/appstore.png",
            "supportsTablet": true,
            "bundleIdentifier": "com.gint13.testingapp"
        },
        "android": {
            "googleServicesFile": "./google-services.json",
            "adaptiveIcon": {
                "backgroundColor": "#000000",
                "foregroundImage": "./assets/icons/android.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.gint13.testingapp"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/icons/splash-screen.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "2813ab38-c4e4-4ed8-beae-4d85778c9066"
            }
        },
        "owner": "gint13"
    }
}
